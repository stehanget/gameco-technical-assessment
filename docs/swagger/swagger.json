{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Gameco marketplace backend technical assessment API with Gin, GORM, Goose, JWT + Redis, and Swagger.",
        "title": "gameco-technical-assessment API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "description": "Authenticates a user and returns an access token plus refresh token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "Login payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.TokenEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "description": "Revokes a refresh token session",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Logout",
                "parameters": [
                    {
                        "description": "Logout payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LogoutRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.MessageEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the authenticated user profile",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.UserEnvelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "description": "Exchanges a refresh token for a new access token and refresh token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh tokens",
                "parameters": [
                    {
                        "description": "Refresh payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RefreshRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.TokenEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "description": "Creates a user and returns an access token plus refresh token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register user",
                "parameters": [
                    {
                        "description": "Register payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/auth.TokenEnvelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/examples": {
            "get": {
                "description": "Returns example records from the boilerplate module",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "examples"
                ],
                "summary": "List examples",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/example.ListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a sample resource to demonstrate the module pattern",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "examples"
                ],
                "summary": "Create example",
                "parameters": [
                    {
                        "description": "Example payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/example.CreateRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/example.ItemResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/examples/async": {
            "post": {
                "description": "Pushes example creation into the Redis-backed worker queue",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "examples"
                ],
                "summary": "Enqueue example creation",
                "parameters": [
                    {
                        "description": "Example payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/example.CreateRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/example.EnqueueItemResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/products": {
            "get": {
                "description": "Lists active, non-deleted products with filtering, search, sorting, and cursor pagination",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "List public products",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Case-insensitive search over product name and description",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Category slug",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Minimum price amount",
                        "name": "min_price",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Maximum price amount",
                        "name": "max_price",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "created_at",
                            "name",
                            "price"
                        ],
                        "type": "string",
                        "default": "created_at",
                        "description": "Sort field",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "type": "string",
                        "default": "desc",
                        "description": "Sort direction",
                        "name": "sort_order",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Opaque cursor returned by the previous response",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "description": "Number of records per page",
                        "name": "per_page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/catalog.ListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/products/{product_public_id}": {
            "get": {
                "description": "Returns one active, non-deleted product by its UUIDv7 public identifier",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Get public product",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Product public identifier",
                        "name": "product_public_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/catalog.ItemResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns liveness status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/health.StatusResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8
                }
            }
        },
        "auth.LogoutRequest": {
            "type": "object",
            "required": [
                "refresh_token"
            ],
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "auth.MessageEnvelope": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "$ref": "#/definitions/auth.MessageResponse"
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "auth.MessageResponse": {
            "type": "object",
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "auth.RefreshRequest": {
            "type": "object",
            "required": [
                "refresh_token"
            ],
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8
                }
            }
        },
        "auth.TokenEnvelope": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "$ref": "#/definitions/auth.TokenResponse"
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "auth.TokenResponse": {
            "type": "object",
            "required": [
                "access_token",
                "expires_in",
                "refresh_token",
                "token_type",
                "user"
            ],
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "refresh_token": {
                    "type": "string"
                },
                "token_type": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/auth.UserResponse"
                }
            }
        },
        "auth.UserEnvelope": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "$ref": "#/definitions/auth.UserResponse"
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "auth.UserResponse": {
            "type": "object",
            "required": [
                "email",
                "permissions",
                "public_id",
                "roles"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "permissions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "public_id": {
                    "type": "string"
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "catalog.CategoryResponse": {
            "type": "object",
            "required": [
                "name",
                "slug"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                }
            }
        },
        "catalog.ItemResponse": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "$ref": "#/definitions/catalog.ProductResponse"
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "catalog.ListMeta": {
            "type": "object",
            "required": [
                "has_more",
                "next_cursor",
                "per_page",
                "request_id"
            ],
            "properties": {
                "has_more": {
                    "type": "boolean"
                },
                "next_cursor": {
                    "type": "string",
                    "x-nullable": true
                },
                "per_page": {
                    "type": "integer"
                },
                "request_id": {
                    "type": "string",
                    "x-nullable": true
                }
            }
        },
        "catalog.ListResponse": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/catalog.ProductResponse"
                    }
                },
                "meta": {
                    "$ref": "#/definitions/catalog.ListMeta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "catalog.ProductResponse": {
            "type": "object",
            "required": [
                "category",
                "created_at",
                "description",
                "name",
                "price_amount",
                "public_id",
                "stock_quantity",
                "updated_at"
            ],
            "properties": {
                "category": {
                    "$ref": "#/definitions/catalog.CategoryResponse"
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-21T10:15:30Z"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "price_amount": {
                    "type": "integer"
                },
                "public_id": {
                    "type": "string"
                },
                "stock_quantity": {
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-21T10:15:30Z"
                }
            }
        },
        "example.CreateRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 2
                }
            }
        },
        "example.EnqueueItemResponse": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "$ref": "#/definitions/example.EnqueueResponse"
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "example.EnqueueResponse": {
            "type": "object",
            "required": [
                "id",
                "queue",
                "state",
                "type"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "queue": {
                    "type": "string"
                },
                "state": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "example.ItemResponse": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "$ref": "#/definitions/example.Response"
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "example.ListResponse": {
            "type": "object",
            "required": [
                "data",
                "meta",
                "success"
            ],
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/example.Response"
                    }
                },
                "meta": {
                    "$ref": "#/definitions/httpx.Meta"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "example.Response": {
            "type": "object",
            "required": [
                "name",
                "public_id"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "public_id": {
                    "type": "string"
                }
            }
        },
        "health.StatusResponse": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        },
        "httpx.ErrorResponse": {
            "type": "object",
            "required": [
                "code",
                "message",
                "request_id",
                "success"
            ],
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string",
                    "x-nullable": true
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "httpx.Meta": {
            "type": "object",
            "required": [
                "request_id"
            ],
            "properties": {
                "request_id": {
                    "type": "string",
                    "x-nullable": true
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "Authentication, session lifecycle, and current-user authorization context.",
            "name": "auth"
        },
        {
            "description": "Development-only example endpoints used to validate the backend module foundation.",
            "name": "examples"
        },
        {
            "description": "Liveness endpoint for runtime health checks.",
            "name": "health"
        }
    ]
}