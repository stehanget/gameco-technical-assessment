Project gameco_technical_assessment {
  database_type: 'PostgreSQL'
  Note: 'Marketplace technical-assessment backend. Internal primary and foreign keys use BIGINT; externally exposed resource identifiers use application-generated UUIDv7 public_id values. Tenant and membership tables are intentionally out of scope.'
}

Enum product_status {
  draft
  active
  inactive
}

Enum cart_status {
  active
  checked_out
  abandoned
}

Enum order_status {
  pending_payment
  payment_failed
  paid
  processing
  completed
  cancelled
}

Enum payment_status {
  pending
  paid
  failed
  expired
}

Enum stock_movement_type {
  checkout
  cancellation
  manual_adjustment
  restock
}

Table users {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'Application-generated UUIDv7 public identifier.']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Global application user. Authentication roles are assigned through user_roles; the users table does not store a single role column.'
}

Table roles {
  id bigint [pk, increment]
  code varchar(64) [not null, unique, note: 'Stable catalog code, for example buyer, seller, or admin.']
  name varchar(128) [not null]
  description varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Authorization role catalog. Role codes are defined in internal/constants/role/codes.go.'
}

Table permissions {
  id bigint [pk, increment]
  code varchar(128) [not null, unique, note: 'Stable capability code such as auth.me or product.read.']
  description varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Authorization permission catalog. Permission codes are defined in internal/constants/permission/codes.go.'
}

Table role_permissions {
  role_id bigint [not null]
  permission_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [pk]
    (permission_id) [name: 'idx_role_permissions_permission_id']
  }

  Note: 'Join table assigning permissions to roles.'
}

Table user_roles {
  user_id bigint [not null]
  role_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id) [pk]
    (role_id) [name: 'idx_user_roles_role_id']
  }

  Note: 'Join table assigning one or more roles to a user. New registrations receive buyer and seller roles.'
}

Table auth_sessions {
  id bigint [pk, increment]
  user_id bigint [not null]
  jti varchar(64) [not null, unique, note: 'UUIDv7 session identifier carried by the minimal JWT claims.']
  refresh_hash varchar(64) [not null, unique]
  roles jsonb [not null, default: `'[]'::jsonb`, note: 'Session authorization snapshot used with the database-backed active session.']
  permissions jsonb [not null, default: `'[]'::jsonb`, note: 'Session authorization snapshot used with the database-backed active session.']
  user_agent text
  ip_address varchar(64)
  expires_at timestamptz [not null]
  revoked_at timestamptz
  last_used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'idx_auth_sessions_user_id']
    (expires_at) [name: 'idx_auth_sessions_expires_at']
    (user_id, expires_at) [name: 'idx_auth_sessions_active_user', note: 'Partial index: WHERE revoked_at IS NULL.']
  }

  Note: 'Database-backed authentication session registry. JWT contains identity and JTI only; roles and permissions are resolved from the active session. Refresh tokens are opaque and only refresh_hash is persisted.'
}

Table categories {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'Application-generated UUIDv7 public identifier.']
  name varchar(128) [not null, unique]
  slug varchar(160) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Product catalog categories used by public catalog filtering.'
}

Table products {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'Application-generated UUIDv7 public identifier.']
  seller_id bigint [not null]
  category_id bigint [not null]
  name varchar(255) [not null]
  description text [not null]
  price_amount bigint [not null, note: 'Integer minor-unit amount; floating point is not used for money.']
  stock_quantity int [not null, default: 0]
  status product_status [not null, note: 'Native PostgreSQL enum: draft, active, or inactive.']
  deleted_at timestamptz [note: 'Nullable soft-delete marker. Deleted products are excluded from public catalog and new transactions.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (seller_id) [name: 'idx_products_seller_id']
    (category_id) [name: 'idx_products_category_id']
    (status, deleted_at) [name: 'idx_products_catalog_visibility']
    (status, deleted_at, created_at, public_id) [name: 'idx_products_catalog_created_at']
    (status, deleted_at, price_amount, public_id) [name: 'idx_products_catalog_price']
    (name) [name: 'idx_products_name_trgm', note: 'PostgreSQL GIN trigram index on lower(name).']
    (description) [name: 'idx_products_description_trgm', note: 'PostgreSQL GIN trigram index on lower(description).']
  }

  Note: 'Product soft-delete is represented by deleted_at, not by a deleted product status. Stock quantity is the current inventory source of truth.'
}

Table carts {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'Application-generated UUIDv7 public identifier.']
  buyer_id bigint [not null]
  status cart_status [not null, note: 'Native PostgreSQL enum: active, checked_out, or abandoned.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, status) [name: 'idx_carts_buyer_status']
    (buyer_id) [unique, name: 'uq_carts_one_active_per_buyer', note: 'Partial unique index: WHERE status = active.']
  }

  Note: 'A buyer may have historical carts, but at most one cart may be active at a time.'
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null]
  product_id bigint [not null]
  quantity int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (cart_id, product_id) [unique, name: 'uq_cart_items_cart_product']
    (product_id) [name: 'idx_cart_items_product_id']
  }
}

Table orders {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'Application-generated UUIDv7 public identifier.']
  buyer_id bigint [not null]
  status order_status [not null, note: 'Native PostgreSQL enum: pending_payment, payment_failed, paid, processing, completed, or cancelled.']
  total_amount bigint [not null, note: 'Integer minor-unit amount.']
  payment_reference varchar(128) [not null, unique]
  payment_expires_at timestamptz
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, created_at) [name: 'idx_orders_buyer_created_at']
    (status, payment_expires_at) [name: 'idx_orders_payment_expiration']
  }

  Note: 'payment_failed represents payment that failed or was not completed within the payment window. payment_expires_at supports expiry handling.'
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]
  seller_id bigint [not null]
  product_name varchar(255) [not null]
  unit_price_amount bigint [not null]
  quantity int [not null]
  subtotal_amount bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id) [name: 'idx_order_items_order_id']
    (seller_id, created_at) [name: 'idx_order_items_seller_created_at']
    (product_id) [name: 'idx_order_items_product_id']
  }

  Note: 'Immutable order snapshot. Product name, seller, unit price, quantity, and subtotal are retained independently of later product changes.'
}

Table checkout_idempotency_keys {
  id bigint [pk, increment]
  buyer_id bigint [not null]
  idempotency_key varchar(255) [not null]
  request_hash varchar(64) [not null]
  order_id bigint
  response_status int
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, idempotency_key) [unique, name: 'uq_checkout_idempotency_buyer_key']
    (order_id) [name: 'idx_checkout_idempotency_order_id']
  }

  Note: 'Coordinates concurrent retries of checkout. A repeated key with a different request hash must be rejected. Completed rows are retained for the configured replay window and then removed by maintenance; pending rows are preserved.'
}

Table payments {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'Application-generated UUIDv7 public identifier.']
  order_id bigint [not null, unique]
  payment_reference varchar(128) [not null, unique]
  provider varchar(64) [not null]
  status payment_status [not null, note: 'Native PostgreSQL enum: pending, paid, failed, or expired.']
  amount bigint [not null, note: 'Integer minor-unit amount.']
  expires_at timestamptz
  paid_at timestamptz
  failed_at timestamptz
  failure_reason varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, expires_at) [name: 'idx_payments_expiration']
  }

  Note: 'Current business payment state. This is separate from payment_webhook_events, which stores provider event inbox records.'
}

Table payment_webhook_events {
  id bigint [pk, increment]
  provider varchar(64) [not null]
  event_id varchar(128) [not null]
  payment_reference varchar(128) [not null]
  event_type varchar(64) [not null]
  payload_hash varchar(64) [not null]
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, event_id) [unique, name: 'uq_payment_webhook_events_provider_event']
    (payment_reference) [name: 'idx_payment_webhook_events_payment_reference']
    (processed_at) [name: 'idx_payment_webhook_events_processed_at']
  }

  Note: 'Idempotent payment-provider webhook inbox. Signature verification, replay-window validation, and payload-hash replay protection are tracked separately from payment business state; raw payload and signatures are not stored.'
}

Table audit_events {
  id bigint [pk, increment]
  actor_user_id bigint
  event_type varchar(128) [not null]
  aggregate_type varchar(64) [not null]
  aggregate_id varchar(128) [not null]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  ip_address varchar(64)
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (aggregate_type, aggregate_id, created_at) [name: 'idx_audit_events_aggregate']
    (actor_user_id, created_at) [name: 'idx_audit_events_actor']
    (event_type, created_at) [name: 'idx_audit_events_type']
  }

  Note: 'Append-only audit trail for sensitive actions such as failed login, price changes, product soft-delete, order status changes, checkout, and webhook processing.'
}

Table stock_movements {
  id bigint [pk, increment]
  product_id bigint [not null]
  order_id bigint
  order_item_id bigint
  actor_user_id bigint
  movement_type stock_movement_type [not null, note: 'Native PostgreSQL enum: checkout, cancellation, manual_adjustment, or restock.']
  quantity_delta int [not null, note: 'Signed quantity change; negative values consume stock.']
  stock_before int [not null]
  stock_after int [not null]
  reason varchar(255) [not null]
  metadata jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, created_at) [name: 'idx_stock_movements_product_created_at']
    (order_id) [name: 'idx_stock_movements_order_id']
    (order_item_id) [name: 'idx_stock_movements_order_item_id']
    (actor_user_id, created_at) [name: 'idx_stock_movements_actor_created_at']
  }

  Note: 'Append-only inventory ledger. products.stock_quantity remains the current source of truth; this table records before/after balances and the business reason for each stock mutation. Every stock mutation should be transactionally paired with a ledger row.'
}

Table user_login_security_states {
  user_id bigint [pk]
  failed_attempt_count int [not null, default: 0]
  first_failed_at timestamptz
  last_failed_at timestamptz
  locked_until timestamptz
  requires_manual_unlock boolean [not null, default: false]
  last_lock_reason varchar(64)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Global per-user login security state. Automatic lockout is triggered by repeated failed login attempts. requires_manual_unlock marks states that must not recover solely because locked_until expires. There is no manual_locked flag because lock is triggered only by repeated failed login attempts.'
}

Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: auth_sessions.user_id > users.id [delete: cascade]
Ref: categories.id < products.category_id
Ref: users.id < products.seller_id
Ref: users.id < carts.buyer_id
Ref: carts.id < cart_items.cart_id [delete: cascade]
Ref: products.id < cart_items.product_id
Ref: users.id < orders.buyer_id
Ref: orders.id < order_items.order_id [delete: cascade]
Ref: products.id < order_items.product_id
Ref: users.id < order_items.seller_id
Ref: users.id < checkout_idempotency_keys.buyer_id
Ref: orders.id < checkout_idempotency_keys.order_id
Ref: orders.id - payments.order_id
Ref: products.id < stock_movements.product_id
Ref: orders.id < stock_movements.order_id
Ref: order_items.id < stock_movements.order_item_id
Ref: users.id < stock_movements.actor_user_id
Ref: users.id < audit_events.actor_user_id
Ref: users.id - user_login_security_states.user_id [delete: cascade]