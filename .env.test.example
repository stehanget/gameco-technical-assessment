# Local-only integration/runtime test configuration.
# Copy to .env.test and adjust only if the default ports are occupied.
APP_NAME=gameco-technical-assessment-test
APP_ENV=test
APP_PORT=28081
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=10s
APP_API_SIGNING_KEYS=
APP_JWT_SECRET=gameco-test-jwt-secret
APP_JWT_PREVIOUS_SECRETS=
APP_PAYMENT_WEBHOOK_SECRET=gameco-test-payment-webhook-secret
APP_PAYMENT_WEBHOOK_EVENT_RETENTION=168h
APP_PAYMENT_WEBHOOK_CLEANUP_INTERVAL=1h
APP_CHECKOUT_IDEMPOTENCY_RETENTION=720h
APP_CHECKOUT_IDEMPOTENCY_CLEANUP_INTERVAL=1h
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=24h

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=gameco-test-only
POSTGRES_DB=gameco_integration
POSTGRES_SSLMODE=disable

REDIS_ADDR=localhost:16379
REDIS_PASSWORD=
REDIS_DB=0
