APP_NAME=gameco-technical-assessment
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=10s
APP_MAX_REQUEST_BODY_BYTES=1048576
APP_API_SIGNATURE_ENABLED=false
# Comma-separated trusted API signing keys: key-id:secret.
APP_API_SIGNING_KEYS=
APP_JWT_SECRET=
# Comma-separated previous signing secrets kept until issued access tokens expire.
APP_JWT_PREVIOUS_SECRETS=
APP_PAYMENT_WEBHOOK_SECRET=
APP_PAYMENT_WEBHOOK_EVENT_RETENTION=168h
APP_PAYMENT_WEBHOOK_CLEANUP_INTERVAL=1h
APP_CHECKOUT_IDEMPOTENCY_RETENTION=720h
APP_CHECKOUT_IDEMPOTENCY_CLEANUP_INTERVAL=1h
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=24h

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gameco_technical_assessment
POSTGRES_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
